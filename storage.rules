rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Phase 9: path gained a {uid} segment (was community/posts/{postId}/...).
    // The uid segment is what lets this rule enforce "write only inside your
    // own path" as a cheap, no-lookup `request.auth.uid == uid` check —
    // the previous scheme had no per-author scoping at all: any signed-in,
    // non-banned user could write into ANY postId's folder, since postId is
    // client-generated and the only prior gate was "are you active", not
    // "is this your post". A firestore.get() ownership check keyed off
    // postId was never viable either way: the image finishes uploading to
    // Storage BEFORE the paired Firestore post document exists (see
    // useComposer.ts), so there is nothing yet to look up at upload time.
    match /community/posts/{uid}/{postId}/{fileName} {
      // Public read — matches Firestore's public read of active posts (D2).
      // Known accepted risk: this is unconditional, so an image/thumbnail
      // whose parent post is later hidden or soft-deleted remains fetchable
      // by anyone who already has the direct URL, for the window between
      // the status change and cleanupPostMedia's trigger completing (Phase
      // 9 closes the bulk of this gap with a real Cloud Function that
      // deletes the underlying files on hide/delete — see functions/src/
      // index.ts — but the trigger is asynchronous, so a brief window with
      // a stale direct URL is still possible in principle). Accepted for V1.
      allow read: if true;

      // Only the path's own owner (Auth-derived, never trusted from any
      // form/request data), only if their account is non-banned, only image
      // files of an explicitly approved type, only under the UUID naming
      // pipeline MediaUploader produces: {uuid}.jpg (full image) and
      // {uuid}_thumb.jpg (thumbnail).
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
                   && (
                        // IMAGE — {uuid}.jpg (full) and {uuid}_thumb.jpg
                        // (thumbnail), the only two shapes the pipeline
                        // produces. Exact MIME allow-list, not a wildcard
                        // (Phase 9 hardening): the previous `image/.*` pattern
                        // also matched image/svg+xml (an XML/script-capable
                        // payload, not a raster image at all) and image/gif
                        // (never audited for animation/size/cost) — both are
                        // structurally rejected, not merely discouraged.
                        //
                        // The uploader re-encodes every image to JPEG, so the
                        // only content type it ever actually sends is
                        // image/jpeg; png and webp remain accepted here purely
                        // so a future direct-upload path is not silently
                        // broken by this rule.
                        (
                          fileName.matches('[a-zA-Z0-9-]+(_thumb)?\\.jpg')
                          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
                          // Hard physical ceiling; D5's compression targets
                          // (≤300KB full / ≤40KB thumb) sit far under this.
                          // A backstop against a compromised or bypassed
                          // client, not the primary size control.
                          && request.resource.size < 2 * 1024 * 1024
                        )
                        ||
                        // VIDEO (web Batch 3) — {uuid}.mp4 or {uuid}.webm.
                        //
                        // The poster frame a video post needs is NOT covered by
                        // this branch: it is uploaded as an ordinary
                        // {uuid}_thumb.jpg and is therefore governed by the
                        // image branch above, unchanged. That is deliberate —
                        // it means cleanupPostMedia's prefix delete already
                        // removes a video's poster with no new code, and it
                        // means the feed renders video posts through exactly
                        // the same <img> path as image posts.
                        //
                        // Only formats a browser can play without transcoding,
                        // because there is no transcoding infrastructure and
                        // this project will not pretend there is.
                        //
                        // 40MB is the hard physical ceiling and the real
                        // enforcement — firestore.rules' matching mediaSize
                        // bound is self-reported metadata, so THIS is the
                        // number that actually limits what a bypassed client
                        // can store.
                        (
                          fileName.matches('[a-zA-Z0-9-]+\\.(mp4|webm)')
                          && request.resource.contentType in ['video/mp4', 'video/webm']
                          && request.resource.size <= 40 * 1024 * 1024
                        )
                      );

      // Phase 9: the path's own owner may delete their own files — required
      // for useComposer.ts's client-side orphan cleanup (Storage upload
      // succeeded, the paired Firestore post-create write then failed) to
      // actually work, since that cleanup runs in the browser under the
      // client SDK, not the Admin SDK. cleanupPostMedia (functions/src/
      // index.ts) — the hide/delete cleanup path — uses the Admin SDK,
      // which bypasses Storage Rules entirely by design and so needs no
      // permission granted here at all. No one may delete another user's
      // files under any path.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
