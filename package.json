{
  "name": "fpv-arabic-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:akl": "tsx scripts/buildAklIndex.ts",
    "gen:manifest": "tsx scripts/buildAppManifest.ts",
    "gen": "npm run gen:akl && npm run gen:manifest",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:community-rules": "firebase emulators:exec --project demo-community-rules-test \"npx tsx scripts/testCommunityRules.ts\"",
    "seed:community-emulator": "firebase emulators:exec --project demo-community-rules-test \"npx tsx scripts/seedCommunityEmulator.ts\""
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.2.7",
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.15.0",
    "lucide-react": "^1.21.0",
    "playwright": "^1.61.0",
    "puppeteer-core": "^25.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.22.4",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
