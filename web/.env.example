# ─────────────────────────────────────────────────────────────────────────────
# FPV بالعربي — web environment
#
# COPY THIS FILE TO .env.local AND FILL IT IN. NEVER COMMIT THE FILLED COPY.
# Every value below is a placeholder; none of them is a real credential.
#
# The web runs on Supabase alone. There are no Firebase variables any more —
# phase six removed the web's Firebase runtime entirely.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public: shipped to the browser (this is expected and safe) ───────────────
# The publishable key identifies the project; it does not authorise anything.
# What a holder of it may do is decided entirely by the row-level-security
# policies in `supabase/migrations/` — which were written on the assumption
# that a stranger has it, because a stranger does. Hiding it is impossible
# anyway: it must reach the browser to work.
#
# Find both under: Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin, used for canonical URLs, Open Graph and sitemap entries —
# and for the payment provider's webhook URL, which must be reachable.
NEXT_PUBLIC_SITE_URL=https://fpv-arabic.com

# ── Server only: NEVER prefixed NEXT_PUBLIC_, never sent to a browser ────────
# Supabase's `service_role` key. It does not merely «have more permissions» —
# it is exempt from row-level security ENTIRELY, so every policy proven by
# `npm run test:rls` and `npm run test:storage` simply does not apply to it.
#
# It is read in exactly ONE file — `lib/backend/supabase/service.ts`, which is
# `server-only` so that a client component importing it fails the build.
# `npm run test:backend` asserts both facts, and `npm run test:web-core`
# asserts them again from the other direction.
#
# The server needs it for: the catalogue's supply-freshness pass, orders,
# payments, the audit log, moderation, and the admin panel's writes.
SUPABASE_SECRET_KEY=

# ── Payments (a later phase; leave empty until Mollie is switched on) ────────
# PAYMENT_PROVIDER=mollie and the API key are documented in
# `web/lib/server/payments/index.ts`. Nothing reads them until the provider is
# explicitly enabled.
