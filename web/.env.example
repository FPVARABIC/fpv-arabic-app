# ─────────────────────────────────────────────────────────────────────────────
# FPV بالعربي — web environment
#
# COPY THIS FILE TO .env.local AND FILL IT IN. NEVER COMMIT THE FILLED COPY.
# Every value below is a placeholder; none of them is a real credential.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public: shipped to the browser (this is expected and safe) ───────────────
# Firebase's web config is not a secret — access is controlled by Firestore and
# Storage rules, not by hiding these. They must match the phone app's values so
# both surfaces talk to the SAME project, the same accounts and the same data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase's publishable key is public for the same reason Firebase's config is:
# it identifies the project, it does not authorise anything. What a holder of it
# may do is decided entirely by the policies in `supabase/migrations/0002` and
# `0003`, which were written on the assumption that a stranger has it — because
# a stranger does. Hiding it is impossible anyway; it must reach the browser to
# work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin, used for canonical URLs, Open Graph and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://fpv-arabic.com

# ── Server only: NEVER prefixed NEXT_PUBLIC_, never sent to a browser ────────
# The service account bypasses every Firestore and Storage rule by design. It is
# a master key. Leaking it is total compromise of the project's data.
#
# In production on Google infrastructure, prefer Application Default Credentials
# and leave all three of these empty — then no private key exists in any
# environment variable at all.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store with literal \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Supabase's `service_role` key. It does not merely «have more permissions» — it
# is exempt from row-level security ENTIRELY, so every policy proven by
# `npm run test:rls` and `npm run test:storage` simply does not apply to it.
#
# It is read in exactly ONE file — `lib/backend/supabase/admin.ts`, which opens
# with `import 'server-only'` so that a client component importing it fails the
# build. `npm run test:backend` asserts both facts, and `npm run test:web-core`
# asserts them again from the other direction.
#
# NOT NEEDED UNTIL THE FIRST SERVER-SIDE WRITE. Reads, sign-in and uploads all
# run on the publishable key above; leave this empty until an order, a role
# change or a moderation action has to be written.
SUPABASE_SECRET_KEY=
