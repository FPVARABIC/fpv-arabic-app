# ─────────────────────────────────────────────────────────────────────────────
# FPV بالعربي — web environment
#
# COPY THIS FILE TO .env.local AND FILL IT IN. NEVER COMMIT THE FILLED COPY.
# Every value below is a placeholder; none of them is a real credential.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public: shipped to the browser (this is expected and safe) ───────────────
# Firebase's web config is not a secret — access is controlled by Firestore and
# Storage rules, not by hiding these. They must match the phone app's values so
# both surfaces talk to the SAME project, the same accounts and the same data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical origin, used for canonical URLs, Open Graph and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://fpv-arabic.com

# ── Server only: NEVER prefixed NEXT_PUBLIC_, never sent to a browser ────────
# The service account bypasses every Firestore and Storage rule by design. It is
# a master key. Leaking it is total compromise of the project's data.
#
# In production on Google infrastructure, prefer Application Default Credentials
# and leave all three of these empty — then no private key exists in any
# environment variable at all.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store with literal \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
